# Copia este archivo como .env.local y completa los valores.

# ---------- Base de datos ----------
# Desarrollo sin cuenta ni Internet (PostgreSQL embebido con PGlite, se guarda en la carpeta .data):
DATABASE_URL=file:./.data/db
# Producción (Vercel) con Neon (https://neon.tech → proyecto → Connection string):
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# ---------- Sesiones (Auth.js) ----------
# Genera uno con:  npx auth secret   (o cualquier texto aleatorio de 32+ caracteres)
AUTH_SECRET=

# ---------- Datos de prueba (npm run seed) ----------
# Contraseña que tendrán las cuentas de demostración creadas por el seed (solo desarrollo).
SEED_PASSWORD=

# URL pública del sitio (en Vercel: https://tu-proyecto.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# ---------- Fotos que suben los negocios ----------
# En desarrollo no hace falta: sin token se guardan en public/uploads.
# En Vercel la crea sola al conectar un Blob store (Storage → Create → Blob → Connect).
# Vercel crea BLOB_STORE_ID (OIDC) o, en cuentas antiguas, BLOB_READ_WRITE_TOKEN.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=
